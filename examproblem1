#include <stdio.h>

int lengthOfLongestSubstring(char *s) {
    int last[256];
    int i;

    for (i = 0; i < 256; i++) {
        last[i] = -1;
    }

    int start = 0;
    int maxLen = 0;

    for (i = 0; s[i] != '\0'; i++) {
        unsigned char ch = (unsigned char)s[i];

        if (last[ch] >= start) {
            start = last[ch] + 1;
        }

        last[ch] = i;

        int len = i - start + 1;
        if (len > maxLen) {
            maxLen = len;
        }
    }

    return maxLen;
}

int main() {
    char s[] = "abcabcbb";
    printf("%d\n", lengthOfLongestSubstring(s));
    return 0;
}
